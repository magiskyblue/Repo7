<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lt_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/LtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LinearLayout" />

        <TextView
            style="@style/LtSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Acomoda los elementos en una sola línea, vertical u horizontal." />

        <!-- Ejemplo 1: vertical -->
        <TextView
            style="@style/LtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="VERTICAL" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatButton
                style="@style/LtBoton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_indigo"
                android:text="Elemento 1" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/LtBoton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_sky"
                android:text="Elemento 2" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/LtBoton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/btn_emerald"
                android:text="Elemento 3" />
        </LinearLayout>

        <!-- Ejemplo 2: horizontal con peso -->
        <TextView
            style="@style/LtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="HORIZONTAL CON layout_weight (1 : 2 : 1)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatButton
                style="@style/LtBoton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/btn_amber"
                android:text="1" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/LtBoton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:background="@drawable/btn_pink"
                android:text="2 (doble)" />

            <androidx.appcompat.widget.AppCompatButton
                style="@style/LtBoton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/btn_amber"
                android:text="1" />
        </LinearLayout>

        <!-- Ejemplo 3: caso real -->
        <TextView
            style="@style/LtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="EJEMPLO REAL: DIÁLOGO" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Guardar los cambios?"
                android:textColor="@color/lt_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/LtSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Los dos botones comparten el ancho en partes iguales." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/LtBotonContorno"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:text="Cancelar" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/LtBoton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_indigo"
                    android:text="Guardar" />
            </LinearLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/LtBotonContorno"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="← Volver al menú" />

    </LinearLayout>
</ScrollView>