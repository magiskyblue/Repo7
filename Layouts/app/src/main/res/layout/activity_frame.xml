<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lt_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/LtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FrameLayout" />

        <TextView
            style="@style/LtSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apila las vistas una sobre otra. La última queda encima." />

        <!-- Ejemplo 1: capas -->
        <TextView
            style="@style/LtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="CAPAS APILADAS" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_gradient">

            <!-- Capa 1: círculo grande -->
            <View
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_gravity="center"
                android:alpha="0.2"
                android:background="@drawable/bg_circle_white" />

            <!-- Capa 2: círculo mediano -->
            <View
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:background="@drawable/bg_circle_white" />

            <!-- Capa 3: texto al centro -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Capas"
                android:textColor="@color/lt_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Capa 4: etiquetas en las esquinas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="14dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Arriba izquierda"
                android:textColor="@color/lt_white"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="14dp"
                android:background="@drawable/btn_amber"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Abajo derecha"
                android:textColor="@color/lt_white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Ejemplo 2: texto sobre imagen -->
        <TextView
            style="@style/LtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="EJEMPLO REAL: TEXTO SOBRE IMAGEN" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/btn_sky">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🌄"
                android:textSize="56sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pill_dark"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="Título sobre la imagen"
                android:textColor="@color/lt_white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Ejemplo 3: insignia -->
        <TextView
            style="@style/LtEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="EJEMPLO REAL: INSIGNIA DE NOTIFICACIÓN" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="bottom|start"
                    android:background="@drawable/btn_indigo"
                    android:gravity="center"
                    android:text="✉"
                    android:textColor="@color/lt_white"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/btn_pink"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/lt_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                style="@style/LtSubtitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Un número encima de un ícono, igual que en las apps de mensajes." />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            style="@style/LtBotonContorno"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="← Volver al menú" />

    </LinearLayout>
</ScrollView>